# QUORIXA Backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Runtime environment: development | production | test
NODE_ENV=development

# Port the backend listens on (keep 5000 for local development)
PORT=5000

# MongoDB connection string (required)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quorixa
MONGO_URI=

# Google Gemini API key (required — used for DOCUMENT EMBEDDINGS and as AI fallback #1)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for chat answer fallback (optional, sensible default)
# GEMINI_MODEL=gemini-2.0-flash

# Groq API key (required — used for chat answer generation, PRIMARY provider)
# https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API key (optional — used as AI fallback #2 when Groq and Gemini fail)
# Leave empty to disable the OpenRouter fallback. Never commit a real key.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model used for the last fallback (optional; models change often,
# pick a currently available model from https://openrouter.ai/models)
OPENROUTER_MODEL=openrouter/free

# Comma-separated list of allowed browser origins.
# Leave empty to allow all origins (development only).
CORS_ORIGIN=http://localhost:5173

# API version reported by /api/v1/health
API_VERSION=1.0.0

# Optional rate limiting (additive to global limits)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60