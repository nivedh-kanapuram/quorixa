    "cors": "^2.8.5",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.0.4",
    "youtube-transcript": "^1.0.1",
    "@google/genai": "^1.0.0",
    "@lancedb/lancedb": "^0.14.1"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.5",
    "@types/node": "^20.5.1",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
